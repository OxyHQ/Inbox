{
  "name": "inbox",
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/frontend"
  ],
  "scripts": {
    "dev": "bun run --cwd packages/frontend start",
    "web": "bun run --cwd packages/frontend web",
    "android": "bun run --cwd packages/frontend android",
    "build": "bun run --cwd packages/frontend build",
    "typecheck": "bun run --cwd packages/frontend typecheck",
    "lint": "bun run --cwd packages/frontend lint",
    "validate:agents-md": "bun ./scripts/check-agents-md-size.mjs && bun ./scripts/test-check-agents-md-size.mjs",
    "test": "bun run --cwd packages/frontend test"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "@oxyhq/bloom": "^0.89.0",
    "@radix-ui/react-slot": "1.2.3",
    "lightningcss": "1.30.1",
    "markdown-it": "12.3.2"
  },
  "engines": {
    "node": ">=20"
  }
}
