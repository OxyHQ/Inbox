{
  "name": "inbox",
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "packages/frontend"
  ],
  "scripts": {
    "dev": "bun run --cwd packages/frontend start",
    "web": "bun run --cwd packages/frontend web",
    "android": "bun run --cwd packages/frontend android",
    "build": "bun run --cwd packages/frontend build",
    "typecheck": "bun run --cwd packages/frontend typecheck",
    "lint": "biome check --error-on-warnings . && bun run --cwd packages/frontend lint",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "doctor:oxy": "oxy-doctor --ci",
    "validate:agents-md": "bun ./scripts/check-agents-md-size.mjs && bun ./scripts/test-check-agents-md-size.mjs",
    "test": "bun run --cwd packages/frontend test"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@oxy.so/bloom": "15.16.0",
    "@oxy.so/services": "13.12.1",
    "@radix-ui/react-slot": "1.2.3",
    "lightningcss": "1.30.1",
    "react-native-css": "3.1.0-rc.0",
    "markdown-it": "12.3.2",
    "@oxy.so/core": "7.9.1",
    "@oxy.so/contracts": "6.1.0",
    "@oxy.so/protocol": "1.5.1"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@oxy.so/doctor": "1.2.0"
  }
}
