{
  "name": "inbox",
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "packages/frontend"
  ],
  "scripts": {
    "dev": "bun run --cwd packages/frontend start",
    "web": "bun run --cwd packages/frontend web",
    "android": "bun run --cwd packages/frontend android",
    "build": "bun run --cwd packages/frontend build",
    "typecheck": "bun run --cwd packages/frontend typecheck",
    "lint": "biome check --error-on-warnings . && bun run --cwd packages/frontend lint",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "doctor:oxy": "oxy-doctor --ci",
    "validate:agents-md": "bun ./scripts/check-agents-md-size.mjs && bun ./scripts/test-check-agents-md-size.mjs",
    "test": "bun run --cwd packages/frontend test"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@oxy.so/bloom": "23.10.0",
    "@oxy.so/services": "15.0.0",
    "@radix-ui/react-slot": "1.2.3",
    "lightningcss": "1.30.1",
    "markdown-it": "12.3.2",
    "@oxy.so/core": "7.55.0",
    "@oxy.so/contracts": "7.5.0",
    "@oxy.so/protocol": "1.11.1",
    "expo-modules-core": "58.1.0",
    "tslib": "2.9.1",
    "@tybys/wasm-util": "0.10.3",
    "@expo/cli": "58.1.19",
    "@expo/router-server": "58.0.21"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@oxy.so/doctor": "1.10.1",
    "semver": "7.8.6"
  }
}
